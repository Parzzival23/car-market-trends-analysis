# ============================================================
# CAR MARKET TRENDS ANALYSIS WITH CAR DEKHO DATA
# ============================================================

# ============================================================
# 1. IMPORT LIBRARIES
# ============================================================

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

sns.set_theme(style="whitegrid")

print("Libraries imported successfully!")


# ============================================================
# 2. LOAD DATASET
# ============================================================

df = pd.read_csv("car_Dekho_DA.csv")

print("Original Dataset Shape:", df.shape)
display(df.head())


# ============================================================
# 3. BASIC DATA UNDERSTANDING
# ============================================================

print("\n========== DATA INFORMATION ==========")
df.info()

print("\n========== STATISTICAL SUMMARY ==========")
display(df.describe())


# ============================================================
# 4. MISSING VALUES & DUPLICATES
# ============================================================

print("\n========== MISSING VALUES ==========")
print(df.isnull().sum())

print("\n========== DUPLICATE ROWS ==========")
print(df.duplicated().sum())


# ============================================================
# 5. REMOVE DUPLICATES
# ============================================================

df = df.drop_duplicates().reset_index(drop=True)

print("\nDataset Shape After Removing Duplicates:", df.shape)


# ============================================================
# 6. CATEGORICAL DATA DISTRIBUTION
# ============================================================

print("\n========== FUEL TYPE ==========")
print(df["Fuel_Type"].value_counts())

print("\n========== SELLER TYPE ==========")
print(df["Seller_Type"].value_counts())

print("\n========== TRANSMISSION ==========")
print(df["Transmission"].value_counts())

print("\n========== PREVIOUS OWNERS ==========")
print(df["Owner"].value_counts())


# ============================================================
# 7. FEATURE ENGINEERING
# ============================================================

REFERENCE_YEAR = 2018

# Car age
df["Car_Age"] = REFERENCE_YEAR - df["Year"]

# Depreciation
df["Depreciation"] = (
    df["Present_Price"] - df["Selling_Price"]
)

# Resale percentage
df["Resale_Percentage"] = (
    df["Selling_Price"] / df["Present_Price"]
) * 100

print("\n========== NEW FEATURES ==========")
display(
    df[
        [
            "Car_Name",
            "Year",
            "Car_Age",
            "Present_Price",
            "Selling_Price",
            "Depreciation",
            "Resale_Percentage"
        ]
    ].head(10)
)


# ============================================================
# 8. FEATURE STATISTICS
# ============================================================

print("\n========== FEATURE STATISTICS ==========")

display(
    df[
        [
            "Car_Age",
            "Depreciation",
            "Resale_Percentage"
        ]
    ].describe()
)


# ============================================================
# 9. PRICE CONSISTENCY CHECK
# ============================================================

print("\n========== SELLING PRICE > PRESENT PRICE ==========")

price_issue = df[
    df["Selling_Price"] > df["Present_Price"]
][
    ["Car_Name", "Selling_Price", "Present_Price"]
]

display(price_issue)

print("Number of inconsistent records:", len(price_issue))


# ============================================================
# 10. ANALYSIS — SELLING PRICE DISTRIBUTION
# ============================================================

plt.figure(figsize=(10, 5))

sns.histplot(
    df["Selling_Price"],
    bins=30,
    kde=True
)

plt.title("Distribution of Used Car Selling Prices")
plt.xlabel("Selling Price")
plt.ylabel("Number of Cars")

plt.show()


# ============================================================
# 11. ANALYSIS — FUEL TYPE DISTRIBUTION
# ============================================================

plt.figure(figsize=(8, 5))

sns.countplot(
    data=df,
    x="Fuel_Type"
)

plt.title("Distribution of Cars by Fuel Type")
plt.xlabel("Fuel Type")
plt.ylabel("Number of Cars")

plt.show()


# ============================================================
# 12. ANALYSIS — AVERAGE PRICE BY FUEL TYPE
# ============================================================

fuel_price = (
    df.groupby("Fuel_Type")["Selling_Price"]
      .mean()
      .sort_values(ascending=False)
)

print("\nAverage Selling Price by Fuel Type:")
print(fuel_price)

plt.figure(figsize=(8, 5))

sns.barplot(
    x=fuel_price.index,
    y=fuel_price.values
)

plt.title("Average Selling Price by Fuel Type")
plt.xlabel("Fuel Type")
plt.ylabel("Average Selling Price")

plt.show()


# ============================================================
# 13. ANALYSIS — TRANSMISSION DISTRIBUTION
# ============================================================

plt.figure(figsize=(8, 5))

sns.countplot(
    data=df,
    x="Transmission"
)

plt.title("Distribution of Cars by Transmission Type")
plt.xlabel("Transmission")
plt.ylabel("Number of Cars")

plt.show()


# ============================================================
# 14. ANALYSIS — AVERAGE PRICE BY TRANSMISSION
# ============================================================

transmission_price = (
    df.groupby("Transmission")["Selling_Price"]
      .mean()
      .sort_values(ascending=False)
)

print("\nAverage Selling Price by Transmission:")
print(transmission_price)

plt.figure(figsize=(8, 5))

sns.barplot(
    x=transmission_price.index,
    y=transmission_price.values
)

plt.title("Average Selling Price by Transmission Type")
plt.xlabel("Transmission")
plt.ylabel("Average Selling Price")

plt.show()


# ============================================================
# 15. ANALYSIS — CAR AGE VS SELLING PRICE
# ============================================================

plt.figure(figsize=(10, 6))

sns.regplot(
    data=df,
    x="Car_Age",
    y="Selling_Price",
    scatter_kws={"alpha": 0.6}
)

plt.title("Relationship Between Car Age and Selling Price")
plt.xlabel("Car Age (Years)")
plt.ylabel("Selling Price")

plt.show()


# ============================================================
# 16. CAR AGE CORRELATION
# ============================================================

age_correlation = (
    df["Car_Age"].corr(df["Selling_Price"])
)

print(
    "Correlation between Car Age and Selling Price:",
    round(age_correlation, 4)
)


# ============================================================
# 17. ANALYSIS — KILOMETERS DRIVEN VS SELLING PRICE
# ============================================================

plt.figure(figsize=(10, 6))

sns.scatterplot(
    data=df,
    x="Kms_Driven",
    y="Selling_Price"
)

plt.title("Kilometers Driven vs Selling Price")
plt.xlabel("Kilometers Driven")
plt.ylabel("Selling Price")

plt.show()


# ============================================================
# 18. KILOMETERS CORRELATION
# ============================================================

kms_correlation = (
    df["Kms_Driven"].corr(df["Selling_Price"])
)

print(
    "Correlation between Kilometers Driven and Selling Price:",
    round(kms_correlation, 4)
)


# ============================================================
# 19. ANALYSIS — MOST FREQUENTLY LISTED MODELS
# ============================================================

model_counts = (
    df["Car_Name"]
      .value_counts()
      .head(10)
)

print("\nTop 10 Most Listed Models:")
print(model_counts)

plt.figure(figsize=(10, 6))

sns.barplot(
    x=model_counts.values,
    y=model_counts.index
)

plt.title("Top 10 Most Frequently Listed Car Models")
plt.xlabel("Number of Listings")
plt.ylabel("Car Model")

plt.show()


# ============================================================
# 20. ANALYSIS — AVERAGE PRICE BY MODEL
# ============================================================

model_price = (
    df.groupby("Car_Name")
      .agg(
          Average_Price=("Selling_Price", "mean"),
          Listings=("Selling_Price", "count")
      )
)

# Keep only models with at least 3 listings
model_price_filtered = (
    model_price[
        model_price["Listings"] >= 3
    ]
    .sort_values(
        "Average_Price",
        ascending=False
    )
)

print("\nTop Models by Average Selling Price:")
display(model_price_filtered.head(10))

top_models = model_price_filtered.head(10)

plt.figure(figsize=(10, 6))

sns.barplot(
    data=top_models,
    x="Average_Price",
    y=top_models.index
)

plt.title("Top 10 Car Models by Average Selling Price")
plt.xlabel("Average Selling Price")
plt.ylabel("Car Model")

plt.show()


# ============================================================
# 21. ANALYSIS — RESALE PERCENTAGE BY FUEL TYPE
# ============================================================

resale_fuel = (
    df.groupby("Fuel_Type")["Resale_Percentage"]
      .mean()
      .sort_values(ascending=False)
)

print("\nAverage Resale Percentage by Fuel Type:")
print(resale_fuel)

plt.figure(figsize=(8, 5))

sns.barplot(
    x=resale_fuel.index,
    y=resale_fuel.values
)

plt.title("Average Resale Percentage by Fuel Type")
plt.xlabel("Fuel Type")
plt.ylabel("Average Resale Percentage (%)")

plt.show()


# ============================================================
# 22. ANALYSIS — SELLER TYPE
# ============================================================

seller_price = (
    df.groupby("Seller_Type")["Selling_Price"]
      .agg(["mean", "count"])
      .sort_values(
          "mean",
          ascending=False
      )
)

print("\nSelling Price by Seller Type:")
print(seller_price)

plt.figure(figsize=(8, 5))

sns.barplot(
    data=df,
    x="Seller_Type",
    y="Selling_Price"
)

plt.title("Selling Price by Seller Type")
plt.xlabel("Seller Type")
plt.ylabel("Selling Price")

plt.show()


# ============================================================
# 23. ANALYSIS — PREVIOUS OWNERS
# ============================================================

owner_price = (
    df.groupby("Owner")["Selling_Price"]
      .agg(["mean", "count"])
)

print("\nSelling Price by Previous Owners:")
print(owner_price)

plt.figure(figsize=(8, 5))

sns.barplot(
    data=df,
    x="Owner",
    y="Selling_Price"
)

plt.title("Average Selling Price by Number of Previous Owners")
plt.xlabel("Previous Owners")
plt.ylabel("Average Selling Price")

plt.show()


# ============================================================
# 24. CORRELATION MATRIX
# ============================================================

numeric_cols = [
    "Year",
    "Selling_Price",
    "Present_Price",
    "Kms_Driven",
    "Owner",
    "Car_Age",
    "Depreciation",
    "Resale_Percentage"
]

correlation_matrix = df[numeric_cols].corr()

print("\n========== CORRELATION MATRIX ==========")

display(
    correlation_matrix.round(2)
)

plt.figure(figsize=(10, 7))

sns.heatmap(
    correlation_matrix,
